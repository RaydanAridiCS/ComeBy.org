# Copy this file to `.env.local` for development: cp .env.example .env.local
# Every variable is documented in docs/configuration.md and validated in src/env.ts.

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug
# Background jobs (emails, summaries, data clean-up). Disable only for debugging.
JOBS_ENABLED=true

# --- Database (docker compose up -d) -------------------------------------------
DATABASE_URL=postgres://comeby:comeby@localhost:5432/comeby

# --- Auth ----------------------------------------------------------------------
# Generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Optional "Sign in with Google": https://console.cloud.google.com/apis/credentials
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Email ---------------------------------------------------------------------
# console = print to terminal, smtp = any SMTP server (Mailpit in dev), resend = Resend API
EMAIL_PROVIDER=smtp
EMAIL_FROM="Comeby <hello@comeby.org>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# --- File storage (cover images) -----------------------------------------------
# local = files on disk (dev), s3 = any S3-compatible storage (Cloudflare R2 in production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Push notifications (optional) ---------------------------------------------
# Generate a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@comeby.org

# --- Bot protection (optional) -------------------------------------------------
# Cloudflare Turnstile. Leave empty to disable in development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional) ------------------------------------------------------
# Self-hosted Umami: https://umami.is
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
